<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8605;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pnarclang.atg" />
    <None Include="sample.pns" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/petrinets2.core.csproj" />
  </ItemGroup>

  <Target
    Name="GenerateArclangParser"
    BeforeTargets="BeforeBuild"
    Inputs="$(MSBuildProjectDirectory)/pnarclang.atg;$(MSBuildProjectDirectory)/Parser.frame;$(MSBuildProjectDirectory)/Scanner.frame"
    Outputs="$(MSBuildProjectDirectory)/Parser.cs;$(MSBuildProjectDirectory)/Scanner.cs">
    <Exec
      Command="coco pnarclang.atg"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

</Project>
