<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CocoExePath Condition="Exists('$(MSBuildProjectDirectory)/../../tools/coco.exe')">$(MSBuildProjectDirectory)/../../tools/coco.exe</CocoExePath>
    <CocoExePath Condition="'$(CocoExePath)' == '' and Exists('$(MSBuildProjectDirectory)/../../tools/Coco.exe')">$(MSBuildProjectDirectory)/../../tools/Coco.exe</CocoExePath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pnarclang.atg" />
    <None Include="sample.pns" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/petrinets2.core.csproj" />
  </ItemGroup>

  <Target
    Name="GenerateArclangParser"
    BeforeTargets="BeforeBuild"
    Condition="'$(CocoExePath)' != ''"
    Inputs="$(MSBuildProjectDirectory)/pnarclang.atg;$(MSBuildProjectDirectory)/Parser.frame;$(MSBuildProjectDirectory)/Scanner.frame"
    Outputs="$(MSBuildProjectDirectory)/Parser.cs;$(MSBuildProjectDirectory)/Scanner.cs">
    <Exec
      Command="$(CocoExePath) pnarclang.atg"
      WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="EnsureCocoExists" BeforeTargets="GenerateArclangParser" Condition="'$(CocoExePath)' == ''">
    <Error Text="Coco executable not found at tools/coco.exe or tools/Coco.exe." />
  </Target>

</Project>
